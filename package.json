{
  "name": "opencode-context-indicator",
  "version": "1.8.0",
  "description": "Real-time context-window usage for OpenCode: per-category token breakdown, /context-diff, a zero-LLM /cx panel with per-session cost and a searchable family-session picker, a TUI sidebar, and an experimental Desktop panel. Dual V1 + V2 plugin entry.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.ts",
    "./rpc": "./lib/rpc.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "index.js",
    "lib/",
    "tui.ts",
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "context-window",
    "tokens",
    "usage",
    "cost",
    "breakdown",
    "tui",
    "sidebar",
    "panel",
    "desktop",
    "gui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "VladSmr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladSmr/opencode-context-indicator.git"
  },
  "homepage": "https://github.com/VladSmr/opencode-context-indicator#readme",
  "bugs": {
    "url": "https://github.com/VladSmr/opencode-context-indicator/issues"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.16",
    "@opentui/core": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "26.6.3",
    "esbuild": "^0.28.2",
    "node-pty": "^1.1.0",
    "solid-js": "^1.9.12",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "scripts": {
    "build:gui": "vite build --config vite.gui.config.mjs",
    "test:types": "tsc --noEmit && tsc -p tsconfig.gui.json --noEmit",
    "test:prepublish": "node test/prepublish.mjs",
    "test:e2e": "node test/e2e-tui.mjs --full",
    "test:e2e:quick": "node test/e2e-tui.mjs --quick",
    "test:drift": "node test/drift-watch.mjs",
    "test:drift:strict": "node test/drift-watch.mjs --strict",
    "prepublishOnly": "npm run build:gui && node test/prepublish.mjs && node test/e2e-tui.mjs --full"
  }
}
