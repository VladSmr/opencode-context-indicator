{
  "name": "opencode-context-indicator",
  "version": "1.1.3",
  "description": "Real-time OpenCode context-window usage indicator: per-category token breakdown written to a log file, plus an optional TUI sidebar. Dual V1 + V2 plugin entry.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.js",
    "lib/",
    "tui.tsx",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "tokens",
    "usage",
    "tui",
    "sidebar"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "VladSmr",
  "repository": { "type": "git", "url": "git+https://github.com/VladSmr/opencode-context-indicator.git" },
  "homepage": "https://github.com/VladSmr/opencode-context-indicator#readme",
  "bugs": { "url": "https://github.com/VladSmr/opencode-context-indicator/issues" },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.16",
    "@opentui/core": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentui/solid": "0.5.12"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.19",
    "@opentui/core": "^0.5.12",
    "solid-js": "^1.9.12"
  }
}
