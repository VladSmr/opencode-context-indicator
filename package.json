{
  "name": "opencode-context-indicator",
  "version": "1.2.2",
  "description": "Real-time OpenCode context-window usage indicator: per-category token breakdown written to a log file, plus an optional TUI sidebar. Dual V1 + V2 plugin entry.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.js",
    "lib/",
    "tui.tsx",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "tokens",
    "usage",
    "tui",
    "sidebar"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "VladSmr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladSmr/opencode-context-indicator.git"
  },
  "homepage": "https://github.com/VladSmr/opencode-context-indicator#readme",
  "bugs": {
    "url": "https://github.com/VladSmr/opencode-context-indicator/issues"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.16",
    "@opentui/core": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentui/solid": "0.5.16"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.19",
    "@opentui/core": "0.5.16",
    "@types/node": "26.6.3",
    "esbuild": "^0.28.2",
    "node-pty": "^1.1.0",
    "solid-js": "^1.9.12",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test:prepublish": "node test/prepublish.mjs",
    "test:e2e": "node test/e2e-tui.mjs --full",
    "test:e2e:quick": "node test/e2e-tui.mjs --quick",
    "test:drift": "node test/drift-watch.mjs"
  },
  "prepublishOnly": "node test/prepublish.mjs && node test/e2e-tui.mjs --full"
}
